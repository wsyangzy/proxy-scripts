[Proxy Chain]

[Proxy Group]
Available = select,HK,TW,SG,KR,JP,US,负载均衡,故障转移,DIRECT,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Available.png
HK = url-test,HK_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Hong_Kong.png
TW = url-test,TW_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Taiwan.png
SG = url-test,SG_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Singapore.png
JP = url-test,JP_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Japan.png
KR = url-test,KR_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Korea.png
US = url-test,US_Filter,interval = 600,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/United_States.png
负载均衡 = load-balance,HK,TW,SG,KR,url = http://cp.cloudflare.com/generate_204,interval = 60,max-timeout = 2000,algorithm = pcc,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Round_Robin.png
故障转移 = fallback,HK,TW,SG,KR,url = http://cp.cloudflare.com/generate_204,interval = 60,max-timeout = 2000,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Bypass.png
国内媒体 = select,Available,HK,US,DIRECT,REJECT,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Media.png
国外媒体 = select,Available,HK,US,DIRECT,REJECT,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/ForeignMedia.png
游戏平台 = select,Available,HK,US,DIRECT,REJECT,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Game.png
广告拦截 = select,Available,REJECT,img-url = https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/AdBlack.png
漏网之鱼 = select,Available,HK,US,DIRECT,REJECT,img-url = https://fastly.jsdelivr.net/gh/shindgewongxj/WHATSINStash@main/icon/fishport.png

[Remote Filter]
ALL_Filter = NameRegex, FilterKey = ".*"
HK_Filter = NameRegex, FilterKey = "(?i)(港|HK|Hong)"
TW_Filter = NameRegex, FilterKey = "(?i)(台|TW|Tai)"
JP_Filter = NameRegex, FilterKey = "(?i)(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)"
KR_Filter = NameRegex, FilterKey = "(?i)(KR|Korea|KOR|首尔|韩|韓)"
US_Filter = NameRegex, FilterKey = "(?i)(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States)"
SG_Filter = NameRegex, FilterKey = "(?i)(新加坡|坡|狮城|SG|Singapore)"

[Rule]
# 当配置文件中没有任何有效策略组时，Loon将使用内置的PROXY策略组
# 当配置文件中存在有效的策略组时，内置的PROXY策略组将不再允许被调用，仅可使用用户配置的策略组
# 配置文件已自带远程GEOIP, cn, DIRECT规则，请勿在此添加
# 请勿修改远程CN REGION规则的排序甚至删除
# MESL 订阅及规则资源访问；GitHub 沿用当前 HK 策略
DOMAIN-SUFFIX,em.mesl.cloud,DIRECT
DOMAIN-SUFFIX,meslcloud.com,Available
DOMAIN-SUFFIX,githubusercontent.com,HK
IP-CIDR,28.0.0.1/8,DIRECT
IP-CIDR,198.18.0.1/16,DIRECT
IP-CIDR,198.18.0.0/15,DIRECT
# IPv6 本地地址范围与 MESL 对齐
IP-CIDR6,::1/128,DIRECT,no-resolve
IP-CIDR6,fc00::/7,DIRECT,no-resolve
IP-CIDR6,fe80::/10,DIRECT,no-resolve

FINAL,漏网之鱼

