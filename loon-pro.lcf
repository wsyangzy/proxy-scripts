[Rule]
# ===== 本地规则 =====
# 高优先级直连域名
DOMAIN-SUFFIX, aowu.tv, 全局直连
DOMAIN-KEYWORD, oracle, 全局直连

# 特殊规则
DOMAIN-SUFFIX, linux.do, 节点选择
DOMAIN-SUFFIX, battlenet.com, 美国手动策略
DOMAIN-SUFFIX, battle.net, 美国手动策略
DOMAIN-SUFFIX, blizzard.com, 美国手动策略
DOMAIN-KEYWORD, hf.space, 美国手动策略
DOMAIN-SUFFIX, anyrouter.top, 香港手动策略
DOMAIN-KEYWORD, elysiver, 香港手动策略

# 直连域名
DOMAIN-SUFFIX, privnode.com, 全局直连
DOMAIN-KEYWORD, openclaudecode, 全局直连
DOMAIN-SUFFIX, right.codes, 全局直连
DOMAIN-SUFFIX, featureassets.org, 全局直连
DOMAIN-KEYWORD, foxcode, 全局直连
DOMAIN-KEYWORD, 88code, 全局直连
DOMAIN-KEYWORD, duckcoding, 全局直连
DOMAIN-SUFFIX, packyapi.com, 全局直连
DOMAIN-SUFFIX, cubence.com, 全局直连
DOMAIN-KEYWORD, elysia, 全局直连

# 局域网地址
GEOIP, CN, 全局直连
# 兜底规则
FINAL, 漏网之鱼

[URL Rewrite]
# URL 重写规则

[Remote Rewrite]
# 远程重写规则

[Script]
# 脚本配置

[Plugin]
# ===== 插件配置（参考 ProxyResource）=====
# 阻止 HTTP DNS
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/Block_HTTPDNS.plugin, enabled = true
# 广告拦截
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/BlockAdvertisers.plugin, enabled = true
# 防止 DNS 泄漏
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/Prevent_DNS_Leaks.plugin, policy = 兜底后备策略, enabled = true
# 节点检测工具
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/Node_detection_tool.plugin, enabled = true
# Sub-Store 订阅管理
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/Sub-Store.plugin, policy = 节点选择, enabled = true
# BoxJs
https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Tool/Loon/Plugin/BoxJs.plugin, policy = 节点选择, enabled = true

[MITM]
# MITM 配置
skip-server-cert-verify = false
